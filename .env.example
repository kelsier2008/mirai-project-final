# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_hex(32))"

# --- Database (docker compose) ---
POSTGRES_USER=club
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clubtracker
DATABASE_URL=postgresql://club:change-me@db:5432/clubtracker

# --- Cache / queue (APP_MODE=production only) ---
REDIS_URL=redis://redis:6379/0

# --- Secrets (required) ---
JWT_SECRET=
# Optional: HMAC key for certificates; derived from JWT_SECRET when blank.
CERT_SECRET=

# --- Runtime ---
# APP_MODE=local runs scheduled jobs in-process; production uses Celery.
# APP_MODE=production
# Comma-separated browser origins allowed to call the API. "*" allows any origin and is
# for local development only. In production list the five role portals exactly, e.g.
# CORS_ORIGINS=https://mirai-super-admin.pages.dev,https://mirai-campus-manager.pages.dev,https://mirai-advisor.pages.dev,https://mirai-coordinator.pages.dev,https://mirai-student.pages.dev
CORS_ORIGINS=*
# Optional regular expression for more origins, e.g. Cloudflare Pages preview deployments:
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.mirai-(super-admin|campus-manager|advisor|coordinator|student)\.pages\.dev$
CORS_ORIGIN_REGEX=
PUBLIC_BASE_URL=http://localhost:8000
# Timezone used for "today", reminder windows and the scheduler.
APP_TIMEZONE=Asia/Kolkata
# Apply pending SQL migrations automatically at startup (1) or not (0).
AUTO_MIGRATE=1

# --- Branding (Mirai) ---
APP_NAME=Mirai Club Activities Tracker
INSTITUTION_NAME=Mirai
APP_SHORT_NAME=Mirai Clubs

# --- Email notifications (optional; disabled while SMTP_HOST is blank) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls | ssl | none
SMTP_SECURITY=starttls

# --- WhatsApp Cloud API (optional; disabled while blank) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
